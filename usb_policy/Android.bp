cc_library_shared {
    name: "libusb_policy_bridge",
    vendor: true,
    srcs: ["usb_policy_bridge.cpp"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.usb-V4-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

prebuilt_etc {
    name: "init.pixel.usb-policy.rc",
    src: "init.pixel.usb-policy.rc",
    sub_dir: "init",
    vendor: true,
}
